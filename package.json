{
  "name": "bibliotecaplay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test:security": "node --test tests/security.test.mjs",
    "check:storage": "node --env-file=.env.local scripts/check-private-storage.mjs",
    "check:database": "node --experimental-strip-types --env-file=.env.local scripts/check-isolated-database.mjs",
    "check:core": "node --experimental-strip-types --env-file=.env.local scripts/check-core-flow.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "6.19.3",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@11.25.0"
}
